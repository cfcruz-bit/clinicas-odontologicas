ext;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="220" width="195" height="54" as="geometry"/></mxCell><mxCell id="ley_2" value="" style="rounded=0;strokeWidth=1.5;html=1;whiteSpace=wrap;strokeColor=#111111;fillColor=#ffffff;fontSize=12;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1615" y="295" width="70" height="44" as="geometry"/></mxCell><mxCell id="ley_2_in" value="" style="ellipse;strokeWidth=1;html=1;whiteSpace=wrap;strokeColor=#111111;fillColor=#ffffff;fontSize=12;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1620" y="300" width="60" height="34" as="geometry"/></mxCell><mxCell id="ley_t2" value="Entidad atributiva: describe a otra y depende de ella" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="290" width="195" height="54" as="geometry"/></mxCell><mxCell id="ley_r0" value="" style="html=1;endArrow=ERmandOne;startArrow=none;endFill=0;endSize=14;strokeColor=#111111;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="390" as="sourcePoint"/><mxPoint x="1685" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_rt0" value="Uno y solo uno" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="376" width="190" height="28" as="geometry"/></mxCell><mxCell id="ley_r1" value="" style="html=1;endArrow=ERzeroToOne;startArrow=none;endFill=0;endSize=14;strokeColor=#111111;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="440" as="sourcePoint"/><mxPoint x="1685" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_rt1" value="Cero o uno" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="426" width="190" height="28" as="geometry"/></mxCell><mxCell id="ley_r2" value="" style="html=1;endArrow=ERzeroToMany;startArrow=none;endFill=0;endSize=14;strokeColor=#111111;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="490" as="sourcePoint"/><mxPoint x="1685" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_rt2" value="Cero o muchos" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="476" width="190" height="28" as="geometry"/></mxCell><mxCell id="ley_p" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#111111;strokeWidth=1.3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1620" y="550" as="sourcePoint"/><mxPoint x="1685" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="ley_pt" value="Relación por nombre, sin llave foránea" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1695" y="530" width="195" height="40" as="geometry"/></mxCell><mxCell id="ley_lee" value="Se lee en el sentido de la línea: un PACIENTE &lt;i&gt;agenda&lt;/i&gt; cero o muchas CITAS." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1615" y="580" width="275" height="40" as="geometry"/></mxCell><mxCell id="nota" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;• CUENTA también guarda &lt;i&gt;quién&lt;/i&gt; hizo cada cosa (siempre de cero o uno a cero o muchos): quién aprobó, dio de alta, eliminó y revisó el odontograma de un PACIENTE; actualizó una HISTORIA CLÍNICA; subió una FOTO; recibió un ABONO; anotó un TRATAMIENTO; subió y firmó un RECIBO; cambió un PRECIO; creó y cobró una ORDEN DE COBRO; resolvió un REPORTE; atendió una SOLICITUD o un PEDIDO DE CONTACTO. No se dibujan para que el diagrama se lea.&lt;br&gt;• CUENTA &lt;i&gt;supervisa&lt;/i&gt; a CUENTA: cada profesor tiene a cargo a sus estudiantes.&lt;br&gt;• BITÁCORA guarda la cuenta y la acción como texto, sin llave foránea: queda aunque la cuenta se borre.&lt;br&gt;• CLÍNICA es la tabla &lt;i&gt;salas&lt;/i&gt; (cada unidad dental). CITA guarda el nombre de la clínica, no su llave.&lt;br&gt;• TRATAMIENTO es la entidad asociativa entre PACIENTE y PROCEDIMIENTO (de muchos a muchos) y copia el precio del momento." style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#999999;fillColor=#fafafa;align=left;verticalAlign=top;spacing=10;fontSize=12;fontFamily=Helvetica;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="1600" y="660" width="300" height="460" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>