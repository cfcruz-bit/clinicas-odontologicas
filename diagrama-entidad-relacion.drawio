r=#24486e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tratamientos" target="recibos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#4d6f93;fontSize=10;fontColor=#24486e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="materiales" target="solicitudes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r19" value="fallas" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#4d6f93;fontSize=10;fontColor=#24486e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="salas" target="reportes"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r20" value="por nombre (sin FK)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=ERzeroToMany;startArrow=ERzeroToOne;endFill=0;startFill=0;endSize=10;startSize=10;strokeColor=#4d6f93;fontSize=10;fontColor=#24486e;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="salas" target="citas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Cómo leer&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; llave primaria · &lt;b&gt;FK&lt;/b&gt; llave foránea · &lt;b&gt;UK&lt;/b&gt; valor único&lt;br&gt;Extremo con dos rayas: uno · con raya y círculo: cero o uno · con círculo y patas: cero o muchos&lt;br&gt;Línea punteada: referencia sin llave foránea, a propósito&lt;br&gt;&lt;br&gt;&lt;b&gt;Para simplificar&lt;/b&gt;&lt;br&gt;• Cada tabla muestra solo sus llaves y sus campos principales.&lt;br&gt;• Las columnas que guardan &lt;i&gt;quién&lt;/i&gt; hizo algo (aprobó, revisó, cobró, firmó…)&lt;br&gt;&amp;nbsp;&amp;nbsp;también apuntan a &lt;b&gt;cuentas&lt;/b&gt;; no se dibujan para no repetir líneas.&lt;br&gt;• &lt;b&gt;trabajo&lt;/b&gt; une estudiantes y pacientes: un paciente puede pasar por varios&lt;br&gt;&amp;nbsp;&amp;nbsp;estudiantes y un estudiante atiende a varios pacientes. Así se evita el muchos a muchos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Colores:&lt;/b&gt; azul usuarios · verde pacientes y expediente · naranja tratamientos y cobros&lt;br&gt;· morado clínicas · gris inventario · amarillo auditoría" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=1;strokeColor=#c9d3df;fillColor=#fafbfc;spacing=10;" vertex="1" parent="1"><mxGeometry x="960" y="990" width="520" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>